{
  "manifest_version": 3,
  "name": "Ygg Alchemy — Compras e Autocraft",
  "description": "Lista de compras da calculadora e fabricação repetida com tecla configurável e controles Iniciar/Parar.",
  "version": "1.2.0",
  "permissions": [
    "storage",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ygg Alchemy — Compras e Autocraft",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://igorkugan.github.io/ygg-alchemy/*"
      ],
      "js": [
        "shared.js",
        "calculator.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jogo.yggidle.com.br/*"
      ],
      "js": [
        "shared.js",
        "shop-adapter.js",
        "shop.js",
        "autocraft-core.js",
        "autocraft-dom.js",
        "autocraft-content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "118",
  "host_permissions": [
    "https://jogo.yggidle.com.br/*"
  ]
}
